{
  "name": "a2acards",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "validate:cards": "node scripts/validate-cards.mjs",
    "build:registry": "node scripts/build-registry.mjs",
    "dev": "npm run build:registry && vite",
    "build": "npm run build:registry && tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "lucide-react": "^0.511.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.4",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.7.0",
    "tailwindcss": "^4.1.4",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "wrangler": "^4.164.0"
  }
}
